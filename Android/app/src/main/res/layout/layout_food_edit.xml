<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="20dp">

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/back"
        app:tint="#000000"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sửa trạng thái món"
        android:textColor="#000000"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnBack" />

    <TextView
        android:id="@+id/tvLabelStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="Trạng thái món ăn"
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <RadioGroup
        android:id="@+id/rgStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/tvLabelStatus">

        <RadioButton
            android:id="@+id/rbAvailable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Còn suất"
            android:textSize="16sp" />

        <RadioButton
            android:id="@+id/rbOutOfStock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hết món"
            android:textSize="16sp" />
    </RadioGroup>

    <TextView
        android:id="@+id/tvLabelDiscount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Giảm giá"
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rgStatus" />

    <RadioGroup
        android:id="@+id/rgDiscountSwitch"
        android:layout_width="wrap_content"
        android:layout_height="35dp"
        android:layout_marginStart="20dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@id/tvLabelDiscount"
        app:layout_constraintStart_toEndOf="@id/tvLabelDiscount"
        app:layout_constraintTop_toTopOf="@id/tvLabelDiscount">

        <RadioButton
            android:id="@+id/rbDiscountOn"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:background="@drawable/rdo_btn_chon"
            android:button="@null"
            android:gravity="center"
            android:checked="true"
            android:text="ON"
            android:textStyle="bold"
            android:textColor="#000000" />

        <RadioButton
            android:id="@+id/rbDiscountOff"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:background="@drawable/rdo_btn_chon"
            android:button="@null"
            android:gravity="center"
            android:text="Off"
            android:textColor="#000000" />
    </RadioGroup>

    <EditText
        android:id="@+id/edtPercent"
        android:layout_width="100dp"
        android:layout_height="40dp"
        android:layout_marginTop="15dp"
        android:background="@drawable/nhap_bogoc"
        android:gravity="center"
        android:text=""
        android:inputType="number"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvLabelDiscount" />

    <TextView
        android:id="@+id/tvPercentSymbol"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="%"
        android:textColor="#000000"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="@id/edtPercent"
        app:layout_constraintStart_toEndOf="@id/edtPercent"
        app:layout_constraintTop_toTopOf="@id/edtPercent" />

    <LinearLayout
        android:id="@+id/layoutStartDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/edtPercent">
        <TextView
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="Từ ngày:"
            android:textColor="#000000"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_start_date"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/nhap_bogoc"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:text="04/11/2025" />

        <ImageButton
            android:id="@+id/btnCalendarStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:srcCompat="@drawable/ic_date_picker" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutEndDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutStartDate">

        <TextView
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="Đến ngày:"
            android:textColor="#000000"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_end_date"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/nhap_bogoc"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:text="04/12/2025" />

        <ImageButton
            android:id="@+id/btnCalendarEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:srcCompat="@drawable/ic_date_picker" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSaveChange"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:background="@drawable/nhap_bogoc"
        android:backgroundTint="#4ADE80"
        android:text="Lưu thay đổi"
        android:textAllCaps="false"
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutEndDate" />

</androidx.constraintlayout.widget.ConstraintLayout>