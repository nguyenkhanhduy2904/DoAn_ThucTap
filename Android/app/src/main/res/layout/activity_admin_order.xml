<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:id="@+id/main"
    tools:context=".AdminOrder">



    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/logo"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#D32F2F"/>

    <TextView
        android:id="@+id/tvBrandName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Golden\nChopsticks"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="@android:color/black"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toEndOf="@id/imgLogo"
        app:layout_constraintTop_toTopOf="@id/imgLogo"
        app:layout_constraintBottom_toBottomOf="@id/imgLogo"/>

    <FrameLayout
        android:id="@+id/frameNoti"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/imgLogo"
        app:layout_constraintBottom_toBottomOf="@id/imgLogo">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/icon_thong_bao"
            app:tint="@android:color/black"/>

<!--        <View-->
<!--            android:layout_width="10dp"-->
<!--            android:layout_height="10dp"-->
<!--            android:background="@drawable/bg_rounded_teal"-->
<!--            android:backgroundTint="@color/red_badge"-->
<!--            android:layout_gravity="top|end"/>-->
    </FrameLayout>

    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Danh sách đơn hàng"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="@android:color/black"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="@id/imgLogo"
        app:layout_constraintTop_toBottomOf="@id/imgLogo"/>

    <LinearLayout
        android:id="@+id/layoutTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="15dp"
        android:layout_marginTop="20dp"
        android:weightSum="5"
        app:layout_constraintTop_toBottomOf="@id/tvHeaderTitle">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnPending"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="Chờ"

            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#333"
            android:textSize="1dp"
            android:backgroundTint="@color/design_default_color_secondary"
            android:stateListAnimator="@null"
            android:maxLines="1"
            app:autoSizeTextType="uniform"
            />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnConfirm"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:textSize="1dp"
            android:text="Xac Nhan"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#333"
            android:backgroundTint="@color/design_default_color_secondary"
            android:stateListAnimator="@null"
            android:maxLines="1"
            app:autoSizeTextType="uniform"
           />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDelivering"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="Dang Giao"
            android:textSize="1dp"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#333"
            android:backgroundTint="@color/design_default_color_secondary"
            android:stateListAnimator="@null"
            android:maxLines="1"
            app:autoSizeTextType="uniform"
            />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnFinish"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:textSize="1dp"
            android:text="Hoan Thanh"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#333"
            android:backgroundTint="@color/design_default_color_secondary"
            android:stateListAnimator="@null"
            android:maxLines="1"
            app:autoSizeTextType="uniform"
            />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCanceled"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:textSize="1dp"
            android:text="Huy"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#333"
            android:backgroundTint="@color/design_default_color_secondary"
            android:stateListAnimator="@null"
            android:maxLines="1"
            app:autoSizeTextType="uniform"
            />
    </LinearLayout>



    <ListView
        android:layout_margin="10dp"
        android:id="@+id/lvOrders"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:dividerHeight="20dp"
        android:divider="@android:color/transparent"
        app:layout_constraintTop_toBottomOf="@id/layoutTabs"

        tools:listitem="@layout/layout_order_staffview"/>

    <include
        android:id="@+id/navBar"
        layout="@layout/layout_nav_bar_admin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>




</androidx.constraintlayout.widget.ConstraintLayout>